{
  "priority": 10,
  "request": {
    "method": "POST",
    "url": "/auth/validate-token",
    "headers": {
      "X-Mock-Scenario": {
        "matches": "SUCCESS_VALIDATE_TOKEN_USER(_.*)?"
      }
    }
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "message": "Token válido",
      "decoded": {
        "userId": "{{#assign 'id'}}{{regexExtract request.headers.X-Mock-Scenario '(?<=SUCCESS_VALIDATE_TOKEN_USER_).+' default=''}}{{/assign}}{{#if id}}{{id}}{{else}}{{randomValue type='UUID'}}{{/if}}",
        "userEmail": "{{randomValue type='UUID'}}@mock.com",
        "roleName": "User",
        "iat": 1789781915,
        "exp": 1789785515
      }
    },
    "transformers": ["response-template"]
  }
}