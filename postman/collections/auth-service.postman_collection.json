  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "function use(fnName) {\r",
          "    const raw = pm.collectionVariables.get(fnName);\r",
          "    if (!raw) throw new Error(`Função não encontrada: ${fnName}`);\r",
          "    return eval(`(${raw})`);\r",
          "}\r",
          "\r",
          "async function createSimpleUserRequest(attempt = 1, scenario = \"SUCCESS_CREATE_USER\") {\r",
          "    const password = \"Password@123\";\r",
          "\r",
          "    if (attempt > 5) {\r",
          "        throw new Error(\"❌ Não foi possível criar usuário após 5 tentativas.\");\r",
          "    }\r",
          "\r",
          "    console.log(`🔄 Tentativa ${attempt} de criar usuário simples...`);\r",
          "\r",
          "    const headers = {\r",
          "        \"Content-Type\": \"application/json\"\r",
          "    };\r",
          "\r",
          "    if (pm.environment.get(\"useMock\") === \"true\" && scenario) {\r",
          "        headers[\"x-mock-scenario\"] = scenario;\r",
          "    }\r",
          "\r",
          "    const response = await new Promise((resolve, reject) => {\r",
          "        pm.sendRequest(\r",
          "            {\r",
          "                url: pm.environment.get(\"user_service_url\"),\r",
          "                method: \"POST\",\r",
          "                header: headers,\r",
          "                body: {\r",
          "                    mode: \"raw\",\r",
          "                    raw: JSON.stringify({\r",
          "                        firstName: pm.variables.replaceIn(\"{{$randomColor}}\"),\r",
          "                        lastName: `${pm.variables.replaceIn(\"{{$randomColor}}\")} ${pm.variables.replaceIn(\"{{$randomColor}}\")}`,\r",
          "                        email: pm.variables.replaceIn(\"{{$randomEmail}}\") ,\r",
          "                        password,\r",
          "                    }),\r",
          "                },\r",
          "            },\r",
          "            (err, res) => {\r",
          "                if (err) return reject(err);\r",
          "                resolve(res);\r",
          "            }\r",
          "        );\r",
          "    });\r",
          "\r",
          "    const json = response.json();\r",
          "\r",
          "    if (response.code === 201 && json?.userId) {\r",
          "        console.log(\"✅ Usuário criado com sucesso:\", json.userId);\r",
          "        pm.collectionVariables.set(\"userRecentCadastreId\", json.userId);\r",
          "        pm.collectionVariables.set(\"userRecentCadastreEmail\", json.email);\r",
          "        pm.collectionVariables.set(\"userRecentCadastrePassword\", password);\r",
          "        pm.collectionVariables.set(\"userRecentCadastreToken\", json.userToken);\r",
          "        return json;\r",
          "    }\r",
          "\r",
          "    console.warn(`⚠ Tentativa ${attempt} falhou (status ${response.code}), tentando novamente...`);\r",
          "    return createSimpleUserRequest(attempt + 1); // recursão simples, sem envolver a Promise externa\r",
          "}\r",
          "\r",
          "function deleteSimpleUserRequest(token, userId) {\r",
          "    if (pm.environment.get(\"useMock\") === \"true\") {\r",
          "        console.log(\"🟡 Modo mock ativo — pulando delete de usuário\");\r",
          "        return;\r",
          "    }\r",
          "    if (!token || !userId) {\r",
          "        console.warn(\"⚠ Token ou userId não informado — ignorando\");\r",
          "        return;\r",
          "    }\r",
          "\r",
          "    pm.sendRequest(\r",
          "        {\r",
          "            url: `${pm.environment.get(\"user_service_url\")}?userId=${userId}`,\r",
          "            method: \"DELETE\",\r",
          "            header: {\r",
          "                \"Authorization\": `Bearer ${token}`,\r",
          "            },\r",
          "        },\r",
          "        (err, res) => {\r",
          "            if (err) {\r",
          "                console.error(\"❌ Erro no DELETE:\", err);\r",
          "                return;\r",
          "            }\r",
          "            pm.collectionVariables.unset(\"userRecentCadastreId\");\r",
          "            pm.collectionVariables.unset(\"userRecentCadastreEmail\");\r",
          "            pm.collectionVariables.unset(\"userRecentCadastrePassword\");\r",
          "            pm.collectionVariables.unset(\"userRecentCadastreToken\");\r",
          "        }\r",
          "    );\r",
          "}\r",
          "\r",
          "function performLogin(email, password, scenario, tokenVarName = \"adminToken\") {\r",
          "    if (!email || !password) {\r",
          "        console.error(\"❌ email ou password não informados\");\r",
          "        return;\r",
          "    }\r",
          "\r",
          "    const headers = {\r",
          "        \"Content-Type\": \"application/json\"\r",
          "    };\r",
          "\r",
          "    if (pm.environment.get(\"useMock\") === \"true\" && scenario) {\r",
          "        headers[\"x-mock-scenario\"] = scenario;\r",
          "    }\r",
          "\r",
          "    pm.sendRequest(\r",
          "        {\r",
          "            url: `${pm.environment.get(\"auth_service_url\")}/login`,\r",
          "            method: \"POST\",\r",
          "            header: headers,\r",
          "            body: {\r",
          "                mode: \"raw\",\r",
          "                raw: JSON.stringify({\r",
          "                    userEmail: email,\r",
          "                    passwordProvided: password,\r",
          "                }),\r",
          "            },\r",
          "        },\r",
          "        (err, res) => {\r",
          "            if (err) {\r",
          "                console.error(\"❌ Erro no login:\", err);\r",
          "                return;\r",
          "            }\r",
          "\r",
          "            const json = res.json();\r",
          "\r",
          "            if (json?.userToken) {\r",
          "                pm.collectionVariables.set(tokenVarName, json.userToken);\r",
          "                console.log(`✅ Token salvo em \"${tokenVarName}\"`);\r",
          "                return;\r",
          "            }\r",
          "\r",
          "            console.error(\"❌ Token não retornado\", json);\r",
          "        }\r",
          "    );\r",
          "}\r",
          "\r",
          "\r",
          "pm.collectionVariables.set(createSimpleUserRequest.name, createSimpleUserRequest.toString());\r",
          "pm.collectionVariables.set(deleteSimpleUserRequest.name, deleteSimpleUserRequest.toString());\r",
          "pm.collectionVariables.set(performLogin.name, performLogin.toString());\r",
          ""
        ],
        "type": "text/javascript"
      }
